{
  "name": "@anby/billing",
  "version": "1.0.0",
  "description": "Anby Billing SDK — debit, credit, balance queries against anby-billing-service. HMAC-signed service-to-service calls.",
  "keywords": [
    "anby",
    "anby-platform",
    "billing",
    "credits",
    "sdk"
  ],
  "license": "MIT",
  "author": "ANBY",
  "homepage": "https://github.com/bravebits-labs/anby-platform-packages#readme",
  "bugs": {
    "url": "https://github.com/bravebits-labs/anby-platform-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bravebits-labs/anby-platform-packages.git",
    "directory": "packages/billing"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../fixup-dual.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anby/contracts": "^1.1.0",
    "@anby/platform-sdk": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
